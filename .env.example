# ============================================================================
# CreditSense AI — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
#   PowerShell:  copy .env.example .env.local
#   bash:        cp .env.example .env.local
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — used as a hosted PostgreSQL database only (no Supabase Auth).
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Browser-safe key. New projects issue `sb_publishable_...`; older projects
# issue a JWT `anon` key. Set whichever one your project gives you — the app
# reads PUBLISHABLE first and falls back to ANON.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses every row-level-security rule.
# Optional: only needed if you use the supabase-js admin client instead of the
# direct Postgres connection below. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Postgres connection — how the app actually reads and writes data.
#
# Our Next.js server is the trusted layer (we run our own auth and role checks
# there), so it talks to Postgres directly rather than through PostgREST.
#
# Supabase direct connections (db.<ref>.supabase.co) are IPv6-only, which
# Vercel's serverless runtime cannot reach. Always use the POOLER host:
#
#   DATABASE_URL -> port 6543, transaction mode. Used by the running app.
#                   Correct choice for serverless: many short-lived queries.
#   DIRECT_URL   -> port 5432, session mode. Used by migrations and seeding,
#                   which need a stable session (advisory locks, DDL).
#
# Find the host under Dashboard -> Project Settings -> Database -> Connection
# pooling. The username is `postgres.<project-ref>`.
#
# NOTE: URL-encode special characters in the password. `@` becomes `%40`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Raw password, un-encoded. Only used by helper scripts that build their own
# connection string.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Our custom auth (bcryptjs + jose JWT in an httpOnly cookie).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# Groq — powers the plain-language narration of score explanations.
#
# OPTIONAL. With no key the app falls back to deterministic templated
# explanations, so every screen still works exactly the same.
#
# The score itself is NEVER produced by an LLM — it comes from the auditable
# scorecard model. The LLM only rephrases already-computed reasons into
# sentences a customer could understand.
#
# Get a key at https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
